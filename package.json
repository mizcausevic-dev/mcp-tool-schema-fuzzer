{
  "name": "mcp-tool-schema-fuzzer",
  "version": "0.1.0",
  "description": "Generate adversarial test cases from an MCP tools/list — valid-minimal, missing-required, wrong-type, extra-field, boundary, enum-violation — with expected accept/reject verdicts you can replay against the server.",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "author": "mizcausevic-dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/mizcausevic-dev/mcp-tool-schema-fuzzer"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "fuzzer",
    "json-schema",
    "testing",
    "security",
    "governance",
    "typescript"
  ],
  "bin": {
    "mcp-tool-schema-fuzzer": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "demo": "tsx src/cli.ts fixtures/tools.json --summary",
    "fuzz": "tsx src/cli.ts",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^4.1.7"
  }
}
